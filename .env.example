# LLM provider: mock (default, no key needed) | gemini | groq
# Copy to backend/.env and fill in. Keys stay on the backend and never reach the browser.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=20

# Backend
DATABASE_PATH=backend/data/decision_sim.db
STAGE_DELAY_MS=250
CORS_ORIGINS=http://localhost:3000

# Frontend proxy target (set in frontend/.env.local if the backend is elsewhere)
BACKEND_URL=http://127.0.0.1:8000
